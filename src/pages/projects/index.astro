---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { titulo } from '../../components/BaseHead.astro';

const projects = (await getCollection('project')).sort((a, b) => {
  const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
  const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
  return dateB - dateA;
});
---

<!doctype html>
<html lang="es">
<head>
  <BaseHead title={`Projects | ${titulo}`} description={SITE_DESCRIPTION} />
  <style>
    main { padding-top: 6rem; }

    /* ════════════════════════════════════════
       CABECERA
       ════════════════════════════════════════ */
    .page-header {
      margin-bottom: 3rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--line);
    }

    .page-header h1 { font-size: 2.6rem; margin-bottom: 0.2rem; }

    .page-sub {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--ink-2);
      letter-spacing: 0.1em;
      margin: 0;
    }

    /* ── Estado vacío ── */
    .empty {
      text-align: center;
      padding: 5em 2em;
      background: var(--surface-1);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      font-family: var(--mono);
      font-size: 0.88rem;
      color: var(--ink-2);
    }

    /* ════════════════════════════════════════
       CARRUSEL DE PROYECTOS — "COVERFLOW"
       Ancho contenido dentro del mismo ancho
       que la cabecera (título), no full-bleed.
       ════════════════════════════════════════ */
    .pw-carousel {
      position: relative;
      width: 100%;
      padding: 1rem 0 3.5rem;
    }

    .pw-viewport {
      position: relative;
      width: 100%;
      height: 460px;
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    }

    .pw-track {
      position: absolute;
      inset: 0;
      perspective: 1600px;
    }

    /* ── Tarjeta ── */
    .pw-slide {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 62%;
      height: 400px;
      display: block;
      border-radius: var(--r-lg);
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      box-shadow: var(--shadow-card);
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      transition:
        transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
        filter 0.6s cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 0.4s ease;
      will-change: transform, opacity, filter;
    }

    .pw-slide.is-active {
      box-shadow: var(--shadow-card), var(--shadow-sig);
      cursor: pointer;
    }

    .pw-slide.is-active:hover {
      box-shadow: 0 24px 70px rgba(0,0,0,0.75), 0 0 0 1px var(--line-hot), var(--shadow-sig);
    }

    .pw-slide.is-active:hover .pw-img {
      transform: scale(1.045);
    }

    /* Imagen — fondo completo */
    .pw-media { position: absolute; inset: 0; }

    .pw-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 0;
      border: none;
      display: block;
      transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
      filter: brightness(0.5) saturate(0.9);
    }

    /* Placeholder sin imagen */
    .pw-placeholder {
      position: absolute;
      inset: 0;
      background: var(--surface-2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ink-3);
    }

    /* Overlay degradado */
    .pw-overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          160deg,
          rgba(7,9,11,0.2) 0%,
          rgba(7,9,11,0.65) 55%,
          rgba(7,9,11,0.96) 100%
        );
    }

    /* Índice grande — marca de agua */
    .pw-watermark {
      position: absolute;
      top: 1rem;
      right: 1.25rem;
      font-family: var(--mono);
      font-size: 5rem;
      font-weight: 900;
      color: rgba(255,255,255,0.05);
      line-height: 1;
      pointer-events: none;
      user-select: none;
      z-index: 1;
    }

    /* Contenido superpuesto */
    .pw-content {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      padding: 2rem 2.25rem;
      z-index: 2;
    }

    .pw-num {
      font-family: var(--mono);
      font-size: 0.65rem;
      color: var(--sig);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin-bottom: 0.4rem;
      opacity: 0.85;
    }

    .pw-title {
      font-family: var(--mono);
      font-weight: 800;
      color: #fff;
      line-height: 1.15;
      letter-spacing: -0.03em;
      margin-bottom: 0.5rem;
      font-size: clamp(1.3rem, 2.4vw, 1.9rem);
      text-shadow: 0 2px 16px rgba(0,0,0,0.5);
    }

    .pw-title::before { content: none !important; }

    /* Descripción, chips y flecha — solo protagonizan en la tarjeta activa */
    .pw-desc {
      color: rgba(255,255,255,0.7);
      font-size: 0.9rem;
      line-height: 1.65;
      margin-bottom: 1rem;
      max-height: 4.4em;
      overflow: hidden;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.4s ease 0.1s, transform 0.4s ease 0.1s;
    }

    .pw-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35em;
      margin-bottom: 1rem;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.4s ease 0.14s, transform 0.4s ease 0.14s;
    }

    .pw-chip {
      padding: 0.2em 0.6em;
      background: rgba(0,232,122,0.1);
      border: 1px solid rgba(0,232,122,0.22);
      border-radius: 100px;
      font-family: var(--mono);
      font-size: 0.66rem;
      color: var(--sig);
      letter-spacing: 0.04em;
      backdrop-filter: blur(6px);
    }

    .pw-arrow {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      font-family: var(--mono);
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--sig);
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.4s ease 0.18s, transform 0.4s ease 0.18s;
    }

    .pw-slide.is-active .pw-desc,
    .pw-slide.is-active .pw-chips,
    .pw-slide.is-active .pw-arrow {
      opacity: 1;
      transform: translateY(0);
    }

    .pw-slide.is-active:hover .pw-arrow {
      gap: 0.6em;
    }

    /* ── Flechas de navegación ── */
    .pw-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 50;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(12,16,20,0.7);
      backdrop-filter: blur(8px);
      border: 1px solid var(--line-mid);
      color: var(--sig);
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    }

    .pw-nav:hover {
      background: rgba(0,232,122,0.12);
      border-color: var(--line-hot);
      transform: translateY(-50%) scale(1.08);
    }

    .pw-nav:active { transform: translateY(-50%) scale(0.96); }

    .pw-nav--prev { left: -0.5rem; }
    .pw-nav--next { right: -0.5rem; }

    /* ── Dots ── */
    .pw-dots {
      position: absolute;
      bottom: 0.5rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 50;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .pw-dot {
      width: 8px;
      height: 8px;
      padding: 0;
      border: none;
      border-radius: 50%;
      background: var(--line-mid);
      cursor: pointer;
      transition: background 0.3s ease, width 0.3s ease, border-radius 0.3s ease;
    }

    .pw-dot.is-active {
      width: 22px;
      border-radius: 4px;
      background: var(--sig);
      box-shadow: 0 0 10px var(--sig-glow);
    }

    /* ════════════════════════════════════════
       RESPONSIVE
       ════════════════════════════════════════ */
    @media (max-width: 1024px) {
      .pw-viewport { height: 420px; }
      .pw-slide { width: 68%; height: 360px; }
      .pw-nav { width: 46px; height: 46px; }
      .pw-nav--prev { left: -0.25rem; }
      .pw-nav--next { right: -0.25rem; }
    }

    @media (max-width: 720px) {
      .page-header h1 { font-size: 2rem; }

      .pw-viewport { height: 400px; }
      .pw-slide { width: 86%; height: 340px; }
      .pw-content { padding: 1.3rem 1.4rem; }
      .pw-num { font-size: 0.6rem; margin-bottom: 0.3rem; }
      .pw-title { font-size: clamp(1.05rem, 5vw, 1.25rem); margin-bottom: 0.35rem; }
      .pw-chips { margin-bottom: 0.7rem; max-height: 2rem; overflow: hidden; }
      .pw-arrow { font-size: 0.72rem; }
      .pw-nav { width: 42px; height: 42px; }
      .pw-nav--prev { left: 0; }
      .pw-nav--next { right: 0; }
      .pw-watermark { font-size: 3rem; top: 0.75rem; right: 1rem; }

      /* En móvil la tarjeta activa muestra siempre su info */
      .pw-desc { font-size: 0.82rem; line-height: 1.55; max-height: 3em; margin-bottom: 0.7rem; }
    }

    @media (max-width: 480px) {
      .page-header h1 { font-size: 1.75rem; }

      .pw-viewport { height: 340px; }
      .pw-slide { width: 90%; height: 300px; }
      .pw-content { padding: 1.05rem 1.15rem; }
      .pw-num { font-size: 0.56rem; margin-bottom: 0.25rem; }
      .pw-title { font-size: clamp(0.98rem, 5.5vw, 1.12rem); margin-bottom: 0.3rem; }
      .pw-desc { font-size: 0.76rem; line-height: 1.5; max-height: 2.6em; margin-bottom: 0.6rem; }
      .pw-chips { margin-bottom: 0.6rem; max-height: 1.7rem; gap: 0.3em; }
      .pw-chip { font-size: 0.6rem; padding: 0.16em 0.5em; }
      .pw-arrow { font-size: 0.68rem; }
      .pw-nav { width: 38px; height: 38px; }
      .pw-watermark { font-size: 2.3rem; top: 0.6rem; right: 0.85rem; }
    }
  </style>
</head>
<body>
  <Header />
  <main id="main-content">

    <div class="page-header reveal-up" data-reveal>
      <h1 data-i18n="projects.title">Proyectos</h1>
      <p class="page-sub" data-i18n-projects-count={String(projects.length)}>
        // {projects.length} proyecto{projects.length !== 1 ? 's' : ''} en total
      </p>
    </div>

    {projects.length === 0 ? (
      <div class="empty" role="status" data-i18n="projects.empty">// No hay proyectos todavía. ¡Pronto!</div>
    ) : (
      <div class="pw-carousel" data-carousel tabindex="0" role="region" aria-roledescription="carrusel" aria-label="Carrusel de proyectos">
        <div class="pw-viewport">
          <div class="pw-track" data-track>
            {projects.map((project, i) => (
              <a
                href={`/projects/${project.id}/`}
                class="pw-slide"
                data-slide
                data-index={String(i)}
                data-name-es={project.data.name}
                data-name-en={project.data.nameEn || project.data.name}
                data-desc-es={project.data.description}
                data-desc-en={project.data.descriptionEn || project.data.description}
                aria-label={`Ver proyecto: ${project.data.name}`}
              >
                <div class="pw-media">
                  {project.data.heroImage ? (
                    <img
                      class="pw-img"
                      src={project.data.heroImage}
                      alt={`Imagen del proyecto ${project.data.name}`}
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                  ) : (
                    <div class="pw-placeholder" aria-hidden="true">
                      <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                        <path d="M8 21h8M12 17v4"/>
                      </svg>
                    </div>
                  )}
                  <div class="pw-overlay" aria-hidden="true"></div>
                  <span class="pw-watermark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                </div>

                <div class="pw-content">
                  <p class="pw-num">
                    {String(i + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}
                  </p>
                  <h2 class="pw-title pw-translatable-name">{project.data.name}</h2>
                  <p class="pw-desc pw-translatable-desc">{project.data.description}</p>

                  {project.data.techs && project.data.techs.length > 0 && (
                    <div class="pw-chips">
                      {project.data.techs.map(t => <span class="pw-chip">{t}</span>)}
                    </div>
                  )}

                  <span class="pw-arrow">
                    <span data-i18n="projects.viewProject">Ver proyecto</span>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"/>
                      <polyline points="12 5 19 12 12 19"/>
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

        {projects.length > 1 && (
          <>
            <button class="pw-nav pw-nav--prev" data-prev type="button" aria-label="Proyecto anterior">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="pw-nav pw-nav--next" data-next type="button" aria-label="Proyecto siguiente">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>

            <div class="pw-dots" data-dots aria-label="Selecciona proyecto">
              {projects.map((_, i) => (
                <button class="pw-dot" data-dot data-dot-index={String(i)} type="button" aria-label={`Ir al proyecto ${i + 1}`}></button>
              ))}
            </div>
          </>
        )}
      </div>
    )}

  </main>
  <Footer />

  <script is:inline>
    (function () {
      /* ─ Reveal genérico (cabecera) ─ */
      var revEls = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        var revObs = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              revObs.unobserve(e.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        revEls.forEach(function (el) { revObs.observe(el); });
      } else {
        revEls.forEach(function (el) { el.classList.add('revealed'); });
      }
    })();

    (function () {
      /* ─ Carrusel de proyectos "coverflow" ─ */
      var carousel = document.querySelector('[data-carousel]');
      if (!carousel) return;

      var track = carousel.querySelector('[data-track]');
      var slides = Array.prototype.slice.call(track.querySelectorAll('[data-slide]'));
      var prevBtn = carousel.querySelector('[data-prev]');
      var nextBtn = carousel.querySelector('[data-next]');
      var dots = Array.prototype.slice.call(carousel.querySelectorAll('[data-dot]'));
      var total = slides.length;
      var current = 0;

      function isSmall() { return window.matchMedia('(max-width: 720px)').matches; }
      function isMedium() { return window.matchMedia('(max-width: 1024px)').matches; }

      function layout() {
        if (!slides.length) return;
        var slideW = slides[0].offsetWidth;
        var small = isSmall();
        var medium = isMedium();
        var step = slideW * (small ? 0.86 : medium ? 0.8 : 0.74);
        var angle = small ? 4 : medium ? 6 : 9;
        var depth = small ? 40 : medium ? 60 : 90;

        slides.forEach(function (slide, i) {
          var diff = i - current;
          if (diff > total / 2) diff -= total;
          if (diff < -total / 2) diff += total;
          var abs = Math.abs(diff);

          var tx = diff * step;
          var rot = -diff * angle;
          var tz = -abs * depth;
          var scale = abs === 0 ? 1 : Math.max(0.72, 1 - abs * 0.14);
          var blur = abs === 0 ? 0 : Math.min(abs * 3.5, 10);
          var opacity = abs === 0 ? 1 : abs === 1 ? 0.55 : abs === 2 ? 0.24 : 0;
          var z = 100 - abs;

          slide.style.transform =
            'translate(-50%, -50%) translateX(' + tx + 'px) translateZ(' + tz + 'px) rotateY(' + rot + 'deg) scale(' + scale + ')';
          slide.style.opacity = String(opacity);
          slide.style.filter = blur ? 'blur(' + blur + 'px)' : 'none';
          slide.style.zIndex = String(z);
          slide.style.pointerEvents = abs > 2 ? 'none' : '';
          slide.classList.toggle('is-active', diff === 0);
          slide.setAttribute('aria-hidden', diff === 0 ? 'false' : 'true');
          slide.setAttribute('tabindex', diff === 0 ? '0' : '-1');
        });

        dots.forEach(function (d, i) { d.classList.toggle('is-active', i === current); });
      }

      function goTo(index) {
        current = ((index % total) + total) % total;
        layout();
      }
      function next() { goTo(current + 1); }
      function prev() { goTo(current - 1); }

      prevBtn && prevBtn.addEventListener('click', function (e) { e.preventDefault(); prev(); });
      nextBtn && nextBtn.addEventListener('click', function (e) { e.preventDefault(); next(); });
      dots.forEach(function (d, i) { d.addEventListener('click', function () { goTo(i); }); });

      /* Navegación por teclado — solo si el carrusel está visible en pantalla */
      var inView = false;
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { inView = e.isIntersecting; });
        }, { threshold: 0.35 });
        io.observe(carousel);
      } else {
        inView = true;
      }
      document.addEventListener('keydown', function (e) {
        if (!inView) return;
        var tag = document.activeElement && document.activeElement.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA') return;
        if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }
      });

      /* Swipe táctil */
      var startX = 0, deltaX = 0, dragging = false;
      track.addEventListener('touchstart', function (e) {
        startX = e.touches[0].clientX;
        deltaX = 0;
        dragging = true;
      }, { passive: true });
      track.addEventListener('touchmove', function (e) {
        if (!dragging) return;
        deltaX = e.touches[0].clientX - startX;
      }, { passive: true });
      track.addEventListener('touchend', function () {
        dragging = false;
        if (Math.abs(deltaX) > 45) {
          if (deltaX < 0) next(); else prev();
        }
      });

      /* Evita navegar por accidente si el usuario acaba de arrastrar */
      track.addEventListener('click', function (e) {
        if (Math.abs(deltaX) > 10) {
          e.preventDefault();
        }
        deltaX = 0;
      }, true);

      window.addEventListener('resize', layout);
      layout();

      /* ─ Traducción de proyectos (i18n) ─ */
      function translateProjects(lang) {
        slides.forEach(function (slide) {
          var nameEl = slide.querySelector('.pw-translatable-name');
          var descEl = slide.querySelector('.pw-translatable-desc');
          if (nameEl) nameEl.textContent = slide.getAttribute('data-name-' + lang) || slide.getAttribute('data-name-es');
          if (descEl) descEl.textContent = slide.getAttribute('data-desc-' + lang) || slide.getAttribute('data-desc-es');
        });
      }

      function updateCounter(lang) {
        var el = document.querySelector('[data-i18n-projects-count]');
        if (!el) return;
        var count = String(total);
        el.textContent = lang === 'en'
          ? '// ' + count + ' project' + (count !== '1' ? 's' : '') + ' total'
          : '// ' + count + ' proyecto' + (count !== '1' ? 's' : '') + ' en total';
      }

      document.addEventListener('DOMContentLoaded', function () {
        var lang = localStorage.getItem('portfolio-lang') || 'es';
        translateProjects(lang);
        updateCounter(lang);
      });

      var _origSet = window.setLanguage;
      window.setLanguage = function (lang) {
        if (_origSet) _origSet(lang);
        translateProjects(lang);
        updateCounter(lang);
      };
    })();
  </script>
</body>
</html>
